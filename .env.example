# Copie ce fichier en .env et remplis les valeurs

# URL de connexion PostgreSQL (Railway l'injecte automatiquement en prod)
# Format : postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:monmotdepasse@localhost:5432/accounts

# Clé secrète pour les sessions (mets une longue chaîne aléatoire en prod)
SESSION_SECRET=change-moi-en-production
